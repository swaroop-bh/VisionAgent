{
  "manifest_version": 3,
  "name": "VisionAgent",
  "version": "0.1.0",
  "description": "Vision-first, privacy-aware, on-device browser agent (SIH26171).",
  "permissions": [
    "sidePanel",
    "tabs",
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "extension/popup/index.html",
    "default_title": "VisionAgent"
  },
  "side_panel": {
    "default_path": "extension/sidepanel/index.html"
  }
}
